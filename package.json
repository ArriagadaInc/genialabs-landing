{
  "name": "genialabs-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page de Genia Labs (genialabs.cl)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "clean": "node scripts/build.mjs --clean",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/assets/css/styles.css --minify",
    "build:knowledge": "node scripts/build-voice-knowledge.mjs",
    "build:html": "npm run build:knowledge && node scripts/build.mjs",
    "build": "npm run build:html && npm run build:css && npm run build:fix",
    "dev": "node scripts/build.mjs && tailwindcss -i ./src/styles.css -o ./dist/assets/css/styles.css --watch",
    "serve": "npx -y serve -l 4173 dist",
    "build:fix": "node scripts/postbuild.mjs",
    "build:og": "node scripts/og-image.mjs",
    "build:iconos": "node scripts/iconos.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/chivo": "^5.3.0",
    "@fontsource/chivo-mono": "^5.3.0",
    "lucide": "1.35.0"
  }
}
